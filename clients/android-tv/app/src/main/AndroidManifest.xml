<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".GaloDoidoApplication"
        android:allowBackup="false"
        android:banner="@drawable/galodoidotv_logo"
        android:icon="@drawable/galodoidotv_logo"
        android:roundIcon="@drawable/galodoidotv_logo"
        android:label="GaloDoidoTV"
        android:theme="@style/Theme.GaloDoidoTV"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".SplashActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="true"
            android:screenOrientation="landscape" />
    </application>
</manifest>
